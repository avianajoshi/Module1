def total_bill(bill_amount, tip_perc):
    final_bill = bill_amount + (tip_perc * bill_amount/100) 
    print("Final bill is:", final_bill)

total_bill(150,20)

def seating_arrangement(guests):
    '''It calculates seating arrangements'''
    if guests == 0 or guests == 1:
        return 1  
    else:
        return guests * seating_arrangement(guests-1)     

print(seating_arrangement.__doc__)

print("Seating arrangement for 1 guest.", seating_arrangement(1))
print("Seating arrangement for 2 guests.", seating_arrangement(2))
print("Seating arrangement for 3 guests.", seating_arrangement(3))
print("Seating arrangement for 4 guests.", seating_arrangement(4))
print("Seating arrangement for 5 guests.", seating_arrangement(5))